# Backend origin (Django). Used by the server-side proxy and route handlers.
# Never hardcoded in code. For a phone on the LAN use the PC's LAN IP.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Optional: a different origin for server-side calls (e.g. http://web:8000
# when the dashboard runs inside Docker). Defaults to NEXT_PUBLIC_API_BASE_URL.
API_BASE_URL=
# Public base URL of this dashboard; the contributor page lives at
# <NEXT_PUBLIC_SITE_URL>/give/<token>. Must match the backend's
# PUBLIC_TOPUP_BASE_URL (which is <this>/give).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to "true" behind HTTPS so auth cookies get the Secure flag.
COOKIE_SECURE=false
