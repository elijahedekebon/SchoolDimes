msgid "%(amount)s UGX from %(student_name)s's savings was sent to %(phone_number)s."
msgstr "%(amount)s UGX kutoka akiba ya %(student_name)s zimetumwa kwa %(phone_number)s."

msgid "%(amount)s UGX was added to %(student_name)s's wallet."
msgstr "%(amount)s UGX zimeongezwa kwenye pochi ya %(student_name)s."

msgid "%(contributor_name)s added %(amount)s UGX to %(student_name)s's wallet."
msgstr "%(contributor_name)s ameongeza %(amount)s UGX kwenye pochi ya %(student_name)s."

msgid "%(sender_name)s sent %(student_name)s a gift of %(amount)s UGX: \"%(message)s\""
msgstr "%(sender_name)s amemtumia %(student_name)s zawadi ya %(amount)s UGX: \"%(message)s\""

msgid "%(student_name)s reached the savings goal \"%(goal_name)s\" (%(target_amount)s UGX)."
msgstr "%(student_name)s amefikia lengo la akiba \"%(goal_name)s\" (%(target_amount)s UGX)."

msgid "%(student_name)s received %(amount)s UGX from %(sender_name)s."
msgstr "%(student_name)s amepokea %(amount)s UGX kutoka kwa %(sender_name)s."

msgid "%(student_name)s tapped in at %(time)s."
msgstr "%(student_name)s ameingia saa %(time)s."

msgid "%(student_name)s's balance is %(balance)s UGX, below your alert level of %(threshold)s UGX. Tap to top up."
msgstr "Salio la %(student_name)s ni %(balance)s UGX, chini ya kiwango chako cha tahadhari cha %(threshold)s UGX. Gusa ili kuongeza."

msgid "%(student_name)s's card was frozen after %(failures)s wrong PIN attempts."
msgstr "Kadi ya %(student_name)s imezuiwa baada ya majaribio %(failures)s ya PIN isiyo sahihi."

msgid "%(student_name)s's card was frozen by %(actor_name)s. No payments can be made with it."
msgstr "Kadi ya %(student_name)s imezuiwa na %(actor_name)s. Hakuna malipo yanayoweza kufanywa nayo."

msgid "%(student_name)s's card was reported lost by %(actor_name)s. Ask the school for a new card."
msgstr "Kadi ya %(student_name)s imeripotiwa kupotea na %(actor_name)s. Omba shule ikupe kadi mpya."

msgid "%(student_name)s's card was unfrozen by %(actor_name)s."
msgstr "Kadi ya %(student_name)s imefunguliwa na %(actor_name)s."

msgid "A gift for %(student_name)s"
msgstr "Zawadi kwa %(student_name)s"

msgid "An offline sale on %(student_name)s's card broke a rule (%(flags_label)s). Please review."
msgstr "Mauzo ya nje ya mtandao kwenye kadi ya %(student_name)s yamevunja sheria (%(flags_label)s). Tafadhali kagua."

msgid "An offline sale on %(student_name)s's card was short by %(shortfall_amount)s UGX (device %(device_name)s). Please review."
msgstr "Mauzo ya nje ya mtandao kwenye kadi ya %(student_name)s yalipungua kwa %(shortfall_amount)s UGX (kifaa %(device_name)s). Tafadhali kagua."

