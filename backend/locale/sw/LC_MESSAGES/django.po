msgid "Your contribution of %(amount)s UGX to \"%(fund_title)s\" was received."
msgstr "Mchango wako wa %(amount)s UGX kwa \"%(fund_title)s\" umepokelewa."

msgid "Your dispute #%(dispute_id)s is now: %(status_label)s. %(notes)s"
msgstr "Malalamiko yako #%(dispute_id)s sasa ni: %(status_label)s. %(notes)s"

msgid "Your scheduled top-up for %(student_name)s was paused after %(failures)s failed attempts. Update it in the app to resume."
msgstr "Malipo yako yaliyopangwa kwa %(student_name)s yamesimamishwa baada ya majaribio %(failures)s kushindikana. Yasasishe kwenye programu ili kuendelea."

msgid "Your scheduled top-up of %(amount)s UGX for %(student_name)s failed: %(reason_label)s"
msgstr "Malipo yako yaliyopangwa ya %(amount)s UGX kwa %(student_name)s yameshindikana: %(reason_label)s"

msgid "Your scheduled top-up of %(amount)s UGX for %(student_name)s was completed."
msgstr "Malipo yako yaliyopangwa ya %(amount)s UGX kwa %(student_name)s yamekamilika."

msgid "Your top-up of %(amount)s UGX for %(student_name)s did not go through: %(reason_label)s"
msgstr "Malipo yako ya %(amount)s UGX kwa %(student_name)s hayakufanikiwa: %(reason_label)s"

