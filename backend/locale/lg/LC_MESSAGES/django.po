msgid "%(amount)s UGX from %(student_name)s's savings was sent to %(phone_number)s."
msgstr "%(amount)s UGX okuva mu nterekero ya %(student_name)s ziweerezeddwa ku %(phone_number)s."

msgid "%(amount)s UGX was added to %(student_name)s's wallet."
msgstr "%(amount)s UGX ziyongeddwa ku wallet ya %(student_name)s."

msgid "%(contributor_name)s added %(amount)s UGX to %(student_name)s's wallet."
msgstr "%(contributor_name)s ayongeddeko %(amount)s UGX ku wallet ya %(student_name)s."

msgid "%(sender_name)s sent %(student_name)s a gift of %(amount)s UGX: \"%(message)s\""
msgstr "%(sender_name)s aweerezza %(student_name)s ekirabo kya %(amount)s UGX: \"%(message)s\""

msgid "%(student_name)s reached the savings goal \"%(goal_name)s\" (%(target_amount)s UGX)."
msgstr "%(student_name)s atuuse ku kiruubirirwa ky'okutereka \"%(goal_name)s\" (%(target_amount)s UGX)."

msgid "%(student_name)s received %(amount)s UGX from %(sender_name)s."
msgstr "%(student_name)s afunye %(amount)s UGX okuva eri %(sender_name)s."

msgid "%(student_name)s tapped in at %(time)s."
msgstr "%(student_name)s ayingidde ku ssaawa %(time)s."

msgid "%(student_name)s's balance is %(balance)s UGX, below your alert level of %(threshold)s UGX. Tap to top up."
msgstr "Ssente za %(student_name)s zisigadde %(balance)s UGX, wansi w'ekipimo kyo ekya %(threshold)s UGX. Nyiga okwongerako."

msgid "%(student_name)s's card was frozen after %(failures)s wrong PIN attempts."
msgstr "Kaadi ya %(student_name)s eyimiriziddwa oluvannyuma lwa PIN enkyamu emirundi %(failures)s."

msgid "%(student_name)s's card was frozen by %(actor_name)s. No payments can be made with it."
msgstr "Kaadi ya %(student_name)s eyimiriziddwa %(actor_name)s. Tekyasobola kusasula."

msgid "%(student_name)s's card was reported lost by %(actor_name)s. Ask the school for a new card."
msgstr "%(actor_name)s ayogedde nti kaadi ya %(student_name)s ebuze. Saba essomero kaadi empya."

msgid "%(student_name)s's card was unfrozen by %(actor_name)s."
msgstr "Kaadi ya %(student_name)s ezziddwawo %(actor_name)s."

msgid "A gift for %(student_name)s"
msgstr "Ekirabo kya %(student_name)s"

msgid "An offline sale on %(student_name)s's card broke a rule (%(flags_label)s). Please review."
msgstr "Okutunda okutaali ku mutimbagano ku kaadi ya %(student_name)s kwamenye etteeka (%(flags_label)s). Kebera."

msgid "An offline sale on %(student_name)s's card was short by %(shortfall_amount)s UGX (device %(device_name)s). Please review."
msgstr "Okutunda okutaali ku mutimbagano ku kaadi ya %(student_name)s kwabulako %(shortfall_amount)s UGX (ekyuma %(device_name)s). Kebera."

