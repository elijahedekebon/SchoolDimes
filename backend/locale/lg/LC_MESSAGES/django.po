msgstr "Okusaba kwo okwa %(request_type_label)s #%(request_id)s kati %(status_label)s."

msgid "Your contribution of %(amount)s UGX to \"%(fund_title)s\" was received."
msgstr "Obuyambi bwo obwa %(amount)s UGX eri \"%(fund_title)s\" bufuniddwa."

msgid "Your dispute #%(dispute_id)s is now: %(status_label)s. %(notes)s"
msgstr "Okwemulugunya kwo #%(dispute_id)s kati: %(status_label)s. %(notes)s"

msgid "Your scheduled top-up for %(student_name)s was paused after %(failures)s failed attempts. Update it in the app to resume."
msgstr "Okusasula kwo okwateekebwawo okwa %(student_name)s kuyimiriziddwa oluvannyuma lw'okulemererwa emirundi %(failures)s. Kukyuse mu app okuddamu."

msgid "Your scheduled top-up of %(amount)s UGX for %(student_name)s failed: %(reason_label)s"
msgstr "Ssente zo ezaateekebwawo %(amount)s UGX eza %(student_name)s ziremye: %(reason_label)s"

msgid "Your scheduled top-up of %(amount)s UGX for %(student_name)s was completed."
msgstr "Ssente zo ezaateekebwawo %(amount)s UGX eza %(student_name)s zisasuddwa."

msgid "Your top-up of %(amount)s UGX for %(student_name)s did not go through: %(reason_label)s"
msgstr "Ssente zo %(amount)s UGX eza %(student_name)s tezituuse: %(reason_label)s"

