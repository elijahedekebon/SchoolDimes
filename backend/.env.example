DATABASE_URL=postgres://schooldimes:schooldimes@db:5432/schooldimes
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
DJANGO_SECRET_KEY=change-me-in-production
JWT_SIGNING_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=*

# ---------------------------------------------------------------- Part 2 ---
# Optional: override the Redis cache, e.g. CACHE_URL=locmemcache:// to run
# without Redis (throttling and low-balance de-duplication then work
# per-process only).
# CACHE_URL=
# Run Celery tasks inline instead of via the broker (handy without Redis).
CELERY_TASK_ALWAYS_EAGER=False

# Largest amount any single money request may carry, in UGX (rule 5).
MAX_TRANSACTION_AMOUNT=5000000

# Payment aggregator. "mock" needs no credentials and never calls out;
# flutterwave | pesapal | dpo are skeletons that raise NotImplementedError.
AGGREGATOR_MODE=mock
# API key / secret key issued by the aggregator (unused in mock mode).
PAYMENT_AGGREGATOR_API_KEY=
# Base URL of the aggregator's API, e.g. https://api.flutterwave.com (unused in mock mode).
PAYMENT_AGGREGATOR_BASE_URL=
# Shared secret used to verify webhook signatures (HMAC-SHA256 in mock mode).
PAYMENT_AGGREGATOR_WEBHOOK_SECRET=change-me-webhook-secret
# Pending deposits older than this many hours are marked expired.
DEPOSIT_EXPIRY_HOURS=24
# A recurring top-up auto-pauses after this many consecutive failures.
RECURRING_TOPUP_MAX_FAILURES=3
# Local (Africa/Kampala) hour at which recurring top-ups run.
RECURRING_TOPUP_RUN_HOUR=8
# Prefix for shareable contributor links (the parent app / web page that
# renders /api/v1/public/topup-links/<token>/).
PUBLIC_TOPUP_BASE_URL=http://localhost:3000/give
# Per-IP rate limit for the unauthenticated /public/ endpoints.
PUBLIC_TOPUP_THROTTLE_RATE=20/min

# Notifications. "log" = stub backend that logs what it would send.
# SMS_BACKEND=africastalking needs the three AFRICASTALKING_* values.
SMS_BACKEND=log
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
# PUSH_BACKEND=fcm needs FCM_PROJECT_ID and a service-account JSON path.
PUSH_BACKEND=log
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=

# Low-balance alert level (UGX) used when neither parent nor school set one.
LOW_BALANCE_DEFAULT_THRESHOLD=2000
# P2P pattern alerts: look-back window in days; alert when one student
# receives from >= DISTINCT_SENDERS different students, or sends >= NEAR_CAP_COUNT
# transfers each >= NEAR_CAP_RATIO of their daily P2P cap.
P2P_ALERT_WINDOW_DAYS=7
P2P_ALERT_DISTINCT_SENDERS=4
P2P_ALERT_NEAR_CAP_RATIO=0.8
P2P_ALERT_NEAR_CAP_COUNT=3
# At most one low-balance alert per guardian per student wallet in this many hours.
LOW_BALANCE_ALERT_THROTTLE_HOURS=12

# --- Part 4A: web surfaces ---------------------------------------------------
# Origins allowed to call the API from a browser (comma-separated). The admin
# dashboard normally goes through its own server-side proxy, so this is only
# needed for direct browser clients.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Per-IP rate limit for credential endpoints (login, register).
AUTH_THROTTLE_RATE=10/min

# --- Web surfaces (Django templates + HTMX, served by this container) -------
# Mark the session and CSRF cookies Secure (set true in production, behind HTTPS).
SESSION_COOKIE_SECURE=False
# Web session lifetime in seconds, renewed on activity (default 8 hours).
SESSION_COOKIE_AGE=28800
# Backend address written into device-provisioning QR codes, e.g. this PC's
# LAN address for a phone on the school Wi-Fi (http://192.168.1.20:8000).
# Blank = the address the admin's browser is using.
DEVICE_API_BASE_URL=
