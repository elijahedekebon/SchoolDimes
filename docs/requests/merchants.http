# SchoolDimes Part 2 -- Merchant network (Section G)
# VS Code "REST Client" extension (humao.rest-client). Click "Send Request".
# Prerequisites: stack running (docker compose up) and `python manage.py seed_demo`.
# IDs below are placeholders: look real ones up with the GET requests
# (e.g. GET {{baseUrl}}/students/ or /wallets/) and edit the @variables.

@baseUrl = http://localhost:8000/api/v1
@password = pw123456
@parentEmail = parent1@schooldimes.test
@parent2Email = parent2@schooldimes.test
@adminEmail = admin@kampaladps.schooldimes.test
@merchantStaffEmail = shop@ntindabookshop.schooldimes.test
# JWTs captured from the login requests below (send those first):
@parentToken = {{parentLogin.response.body.access}}
@adminToken = {{adminLogin.response.body.access}}
@shopToken = {{shopLogin.response.body.access}}

# Paste the raw tokens printed by `python manage.py seed_demo` (they rotate on every run):
@canteenToken = PASTE_CANTEEN_DEVICE_TOKEN
@merchantToken = PASTE_MERCHANT_DEVICE_TOKEN
@attendanceToken = PASTE_ATTENDANCE_DEVICE_TOKEN

@merchantId = 1
@merchantStaffUserId = 1

### Log in as parent1 (guardian of Amina + Brian)
# @name parentLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"email": "{{parentEmail}}", "password": "{{password}}"}

### Log in as the Kampala school admin
# @name adminLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"email": "{{adminEmail}}", "password": "{{password}}"}

### Log in as the merchant's staff user
# @name shopLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{"email": "{{merchantStaffEmail}}", "password": "{{password}}"}

### Merchants (admin sees all, to approve shared ones)
GET {{baseUrl}}/merchants/
Authorization: Bearer {{adminToken}}

### Register a merchant (auto-approved for my school)
POST {{baseUrl}}/merchants/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"name": "Kisaasi Tailors", "category": "tailor", "contact_phone": "0772400400"}

### Approve for my school
POST {{baseUrl}}/merchants/{{merchantId}}/approve/
Authorization: Bearer {{adminToken}}

### Suspend for my school
POST {{baseUrl}}/merchants/{{merchantId}}/suspend/
Authorization: Bearer {{adminToken}}

### Link a merchant_staff user
POST {{baseUrl}}/merchants/{{merchantId}}/staff/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"user": {{merchantStaffUserId}}}

### Merchants my child may use (parent)
GET {{baseUrl}}/merchants/
Authorization: Bearer {{parentToken}}

### Register a merchant device (admin)
POST {{baseUrl}}/pos/devices/register/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"device_name": "Shop till", "device_role": "merchant", "merchant": {{merchantId}}}

### Merchant cache (cards of every approving school, merchant products only)
GET {{baseUrl}}/pos/cache/
Authorization: Device {{merchantToken}}

### Statement as merchant staff (all schools)
GET {{baseUrl}}/merchants/{{merchantId}}/statement/
Authorization: Bearer {{shopToken}}

### Statement as school admin (own school only)
GET {{baseUrl}}/merchants/{{merchantId}}/statement/?from=2026-09-01&to=2026-09-30
Authorization: Bearer {{adminToken}}

### Parent blocks a merchant for their child
POST {{baseUrl}}/policies/
Authorization: Bearer {{parentToken}}
Content-Type: application/json

{"student": 1, "blocked_merchants": [{{merchantId}}]}
